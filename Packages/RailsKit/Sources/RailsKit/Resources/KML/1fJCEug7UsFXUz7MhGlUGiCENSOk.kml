      <name>Map Details</name>
      <Placemark>
        <name>SP-CP Promontory Branch</name>
        <description>Ogden to Corinne Junction,</description>
        <styleUrl>#line-0000FF-5000</styleUrl>
        <LineString>
          <tessellate>1</tessellate>
          <coordinates>
            -112.08123,41.53884,0
            -112.08026,41.53828,0
            -112.07919,41.53746,0
