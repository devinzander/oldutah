            -112.080803,41.539342,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Cecil Junction</name>
        <description>SP-CP Promontory Line branched off from Lucin Cutoff in 1903.</description>
        <styleUrl>#icon-22</styleUrl>
        <Point>
          <coordinates>
            -111.987376,41.23493,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name><![CDATA[1869 CP-UP "Junction"]]></name>
        <description><![CDATA[Approximate site of 1869 agreement for the junction between UP and CP, "five miles west of Ogden"]]></description>
        <styleUrl>#icon-22</styleUrl>
        <Point>
          <coordinates>
            -112.012267,41.290738,0
          </coordinates>
        </Point>
      </Placemark>
