        <Point>
          <coordinates>
            -112.039261,41.352201,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Utah Northern connection, 1871</name>
        <description>The narrow gauge Utah Northern laid its first rail near this location in November 1871. Perry was then known as Three Mile Creek.</description>
        <styleUrl>#icon-22</styleUrl>
        <Point>
          <coordinates>
            -112.054517,41.456815,0
          </coordinates>
        </Point>
