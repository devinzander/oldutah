<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>SP-CP North From Ogden</name>
    <description>Locating the former SP-CP Promontory line from Ogden, north to Corinne. Hot Springs to Perry location from 1955 USGS topo map, before Willard Bay Reservoir was built.</description>
