      <Placemark>
        <name>Garden City Plat A</name>
        <description>Approved November 22, 1888</description>
        <styleUrl>#poly-B7DBAB-1000-77</styleUrl>
        <Polygon>
          <outerBoundaryIs>
            <LinearRing>
              <tessellate>1</tessellate>
