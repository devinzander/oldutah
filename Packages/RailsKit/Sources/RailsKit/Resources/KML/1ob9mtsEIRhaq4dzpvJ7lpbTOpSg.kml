    <Folder>
      <name>Map Details</name>
      <Placemark>
        <name>Streetcar route; electric 3 miles</name>
        <description>Reported as 8 miles in 1895; 3 miles electrified in 1893; remaining 5 miles operated by steam dummy, until abandoned in 1895</description>
        <styleUrl>#line-DB4436-3131</styleUrl>
        <LineString>
          <tessellate>1</tessellate>
          <coordinates>
