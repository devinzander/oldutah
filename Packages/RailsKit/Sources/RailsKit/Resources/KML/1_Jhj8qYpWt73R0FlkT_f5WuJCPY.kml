    <Folder>
      <name>Map Details</name>
      <Placemark>
        <name>Mascotte Tunnel Portal</name>
        <description>From USGS topo map</description>
        <styleUrl>#icon-503-DB4436</styleUrl>
        <Point>
          <coordinates>
            -112.0980173,40.5270768,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name><![CDATA[Dalton & Lark surface works]]></name>
        <styleUrl>#icon-503-DB4436-nodesc</styleUrl>
        <Point>
          <coordinates>
            -112.1175385,40.5271094,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Mascotte Tunnel</name>
        <description><![CDATA[Approximate; Lark to Dalton & Lark, then to Yosemite, then to Ohio Copper, then to Commercial mine (near Niagara tunnel).]]></description>
        <styleUrl>#line-DB4436-2744</styleUrl>
        <LineString>
          <tessellate>1</tessellate>
          <coordinates>
            -112.0981139,40.5271053,0
            -112.1156723,40.527681,0
            -112.1190313,40.5257606,0
            -112.1289558,40.5214748,0
            -112.1358955,40.5143701,0
          </coordinates>
        </LineString>
      </Placemark>
      <Placemark>
        <name>Ohio Copper Branch, Mascotte</name>
        <styleUrl>#line-DB4436-2356-nodesc</styleUrl>
        <LineString>
          <tessellate>1</tessellate>
          <coordinates>
            -112.1434539,40.5231949,0
            -112.1289558,40.5214748,0
          </coordinates>
        </LineString>
      </Placemark>
      <Placemark>
        <name>Bingham Lark Tunnel</name>
        <styleUrl>#line-009D57-2938-nodesc</styleUrl>
        <LineString>
          <tessellate>1</tessellate>
          <coordinates>
            -112.0966507,40.5277832,0
            -112.1152401,40.5257797,0
            -112.124043,40.5194748,0
            -112.152562,40.5112104,0
          </coordinates>
        </LineString>
      </Placemark>
      <Placemark>
        <name>Lark Branch Bingham Tunnel</name>
        <styleUrl>#line-009D57-3325-nodesc</styleUrl>
        <LineString>
          <tessellate>1</tessellate>
          <coordinates>
            -112.1152401,40.5257797,0
            -112.1175437,40.5269592,0
          </coordinates>
        </LineString>
      </Placemark>
      <Placemark>
        <name>Brooklyn and Lead Mine surface works</name>
        <styleUrl>#icon-503-DB4436-nodesc</styleUrl>
        <Point>
          <coordinates>
            -112.1223021,40.5223141,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Ohio Copper surface works</name>
        <description>Abandoned in 1907 in favor of using the Mascotte tunnel for all purposes (approximate)</description>
        <styleUrl>#icon-503-DB4436</styleUrl>
        <Point>
          <coordinates>
            -112.1456694,40.5230971,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Commercial</name>
        <description>Lower Commercial tunnel, and Paradox tunnel openings (approximate)</description>
        <styleUrl>#icon-503-DB4436</styleUrl>
        <Point>
          <coordinates>
            -112.1374726,40.5143375,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Bingham Tunnel Portal</name>
        <description><![CDATA[New "Lark" tunnel (21,000 ft.) completed by Kennecott in 1951 to replace the Mascotte Tunnel.]]></description>
        <styleUrl>#icon-503-DB4436</styleUrl>
        <Point>
          <coordinates>
            -112.0966507,40.5277832,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Ohio Copper Mill Site</name>
        <styleUrl>#icon-503-DB4436-nodesc</styleUrl>
        <Point>
          <coordinates>
            -112.0846653,40.5242306,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Butterfield Tunnel</name>
        <description>Completed in 1898.</description>
        <styleUrl>#icon-503-DB4436</styleUrl>
        <Point>
          <coordinates>
            -112.1228492,40.4897982,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Butterfield Tunnel</name>
        <description><![CDATA[Approximate; drains Queen and Silver Shield ground, extended in 1923 to drain USSR&M Niagara ground. 8,200 feet]]></description>
        <styleUrl>#line-DB4436-2356</styleUrl>
        <LineString>
          <tessellate>1</tessellate>
          <coordinates>
            -112.1230852,40.4899206,0
            -112.1448326,40.4976798,0
          </coordinates>
        </LineString>
      </Placemark>
      <Placemark>
        <name>Butterfield Extension</name>
        <description><![CDATA[Approximate. Extended in 1923 to drain USSR&M Niagara ground. 10,000 feet.]]></description>
        <styleUrl>#line-DB4436-3519</styleUrl>
        <LineString>
          <tessellate>1</tessellate>
          <coordinates>
            -112.1448326,40.4976798,0
            -112.1556274,40.5094333,0
          </coordinates>
        </LineString>
      </Placemark>
      <Placemark>
        <name>Utah Metal Mines Tunnel</name>
        <description><![CDATA[Started 1909 by Utah Metal & Tunnel Co.; completed 1913; Carr Fork to Middle Canyon; 11,400 feet]]></description>
        <styleUrl>#line-DB4436-2733</styleUrl>
        <LineString>
          <tessellate>1</tessellate>
          <coordinates>
            -112.1698093,40.5138644,0
            -112.1919537,40.4867791,0
          </coordinates>
        </LineString>
      </Placemark>
      <Placemark>
        <name>Elton Tunnel, Tooele portal</name>
        <description>Started 1937; completed 1941; 24,000 feet</description>
        <styleUrl>#icon-503-DB4436</styleUrl>
        <Point>
          <coordinates>
            -112.2396111,40.5603245,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Elton Tunnel</name>
        <description>Completed in 1941</description>
        <styleUrl>#line-DB4436-2938</styleUrl>
